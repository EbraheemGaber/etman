		{
			"label": "Validate catalog files",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require('fs');const path=require('path');const products=JSON.parse(fs.readFileSync('backend/data/restaurant-catalog-estimates.json','utf8'));const images=[...new Set(products.flatMap(p=>p.images))];const missing=images.filter(url=>!fs.existsSync(path.join('frontend/public',url.slice(1))));if(products.length!==235||products.some(p=>!p.priceIsEstimate||p.stockQuantity!==0||!Number.isFinite(p.price)||p.price<=0)||missing.length)throw new Error(JSON.stringify({products:products.length,missingImages:missing.length}));const bytes=images.reduce((sum,url)=>sum+fs.statSync(path.join('frontend/public',url.slice(1))).size,0);console.log(JSON.stringify({products:products.length,categories:new Set(products.map(p=>p.category)).size,uniqueImages:images.length,missingImages:missing.length,zeroStock:products.filter(p=>p.stockQuantity===0).length,priceRange:[Math.min(...products.map(p=>p.price)),Math.max(...products.map(p=>p.price))],imageBytes:bytes},null,2))"
			],
			"isBackground": false
		},
		{
			"label": "Check catalog asset integrity",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const fs=require(\"fs\");const path=require(\"path\");const p=JSON.parse(fs.readFileSync(\"backend/data/restaurant-catalog-estimates.json\",\"utf8\"));const imgs=[...new Set(p.flatMap(x=>x.images))];const missing=imgs.filter(u=>!fs.existsSync(path.join(\"frontend/public\",u.slice(1))));if(p.length!==235||p.some(x=>!x.priceIsEstimate||x.stockQuantity!==0||!Number.isFinite(x.price)||x.price<=0)||missing.length)throw Error(JSON.stringify({products:p.length,missing}));const bytes=imgs.reduce((n,u)=>n+fs.statSync(path.join(\"frontend/public\",u.slice(1))).size,0);console.log(JSON.stringify({products:p.length,categories:new Set(p.map(x=>x.category)).size,uniqueImages:imgs.length,missingImages:missing.length,zeroStock:p.filter(x=>x.stockQuantity===0).length,imageBytes:bytes},null,2))"
			],
			"isBackground": false
		},
